# 'All' must be defined before module rules are made visible.
rule all:
    input:
        compile_output_file_list,


# ===========================================================================
# HYDRA-GENETICS MODULE: alignment
# ===========================================================================

module alignment:
    snakefile:
        get_module_snakefile(
            config,
            "hydra-genetics/alignment",
            path="workflow/Snakefile",
            tag=config["modules"]["alignment"],
        )
    config:
        config


# Hydra's minimap2 index rule.  FASTQ units are aligned and all units merged
# with Hydra rules below; unmapped-BAM units, already-aligned BAMs and Dorado
# output are handled by local rules.
use rule minimap2_index from alignment as alignment_minimap2_index with:
    input:
        target=config["reference"]["fasta"],
    output:
        mmi=get_reference_index(),


# FASTQ and unmapped-BAM units go through Hydra's minimap2_align.  The wrapper
# reads a FASTQ as is, so the -y that copies the MM/ML tags from the read header,
# the read group and the per-unit preset all travel in params.extra.  For a BAM
# the wrapper converts with `samtools fastq -T "*"` and adds -y itself.
use rule minimap2_align from alignment as alignment_minimap2_fastq_align with:
    input:
        query=lambda wildcards: get_fastq_for_alignment(wildcards),
        target=lambda wildcards: get_reference_target_for_unit(wildcards),
    output:
        bam="alignment/units/{sample}_{type}_{processing_unit}_{barcode}.from_fastq.bam",
    params:
        extra=lambda wildcards: " ".join(
            part
            for part in (
                config.get("minimap2_align", {}).get("extra", ""),
                "-R '{}'".format(get_minimap2_read_group(wildcards)),
                "-x {}".format(get_minimap2_preset_for_unit(wildcards)),
            )
            if part
        ),
        sorting="coordinate",
        sort_extra="",
    log:
        "logs/minimap2_fastq_align/{sample}_{type}_{processing_unit}_{barcode}.log",
    benchmark:
        repeat(
            "benchmarks/minimap2_fastq_align/{sample}_{type}_{processing_unit}_{barcode}.tsv",
            config.get("minimap2_fastq_align", {}).get("benchmark_repeats", 1),
        )
    threads: config.get("minimap2_fastq_align", {}).get("threads", config["default_resources"]["threads"])
    resources:
        mem_mb=config.get("minimap2_fastq_align", {}).get("mem_mb", config["default_resources"]["mem_mb"]),
        mem_per_cpu=config.get("minimap2_fastq_align", {}).get("mem_per_cpu", config["default_resources"]["mem_per_cpu"]),
        partition=config.get("minimap2_fastq_align", {}).get("partition", config["default_resources"]["partition"]),
        threads=config.get("minimap2_fastq_align", {}).get("threads", config["default_resources"]["threads"]),
        time=config.get("minimap2_fastq_align", {}).get("time", config["default_resources"]["time"]),
    container:
        config.get("minimap2_fastq_align", {}).get("container", config.get("minimap2_align", {}).get("container", config["default_container"]))


# Unmapped-BAM units.  The wrapper's `samtools fastq -T "*"` carries every tag of
# the uBAM (instrument tags such as qs and ts as well as MM and ML) into the
# aligned BAM; the old local rule carried MM and ML only (D17).
use rule minimap2_align from alignment as alignment_minimap2_ubam_align with:
    input:
        query=lambda wildcards: get_unmapped_bam_for_alignment(wildcards),
        target=lambda wildcards: get_reference_target_for_unit(wildcards),
    output:
        bam="alignment/units/{sample}_{type}_{processing_unit}_{barcode}.from_ubam.bam",
    params:
        extra=lambda wildcards: " ".join(
            part
            for part in (
                config.get("minimap2_align", {}).get("extra", ""),
                "-R '{}'".format(get_minimap2_read_group(wildcards)),
                "-x {}".format(get_minimap2_preset_for_unit(wildcards)),
            )
            if part
        ),
        sorting="coordinate",
        sort_extra="",
    log:
        "logs/minimap2_unmapped_bam_align/{sample}_{type}_{processing_unit}_{barcode}.log",
    benchmark:
        repeat(
            "benchmarks/minimap2_unmapped_bam_align/{sample}_{type}_{processing_unit}_{barcode}.tsv",
            config.get("minimap2_unmapped_bam_align", {}).get("benchmark_repeats", 1),
        )
    threads: config.get("minimap2_unmapped_bam_align", {}).get("threads", config["default_resources"]["threads"])
    resources:
        mem_mb=config.get("minimap2_unmapped_bam_align", {}).get("mem_mb", config["default_resources"]["mem_mb"]),
        mem_per_cpu=config.get("minimap2_unmapped_bam_align", {}).get("mem_per_cpu", config["default_resources"]["mem_per_cpu"]),
        partition=config.get("minimap2_unmapped_bam_align", {}).get("partition", config["default_resources"]["partition"]),
        threads=config.get("minimap2_unmapped_bam_align", {}).get("threads", config["default_resources"]["threads"]),
        time=config.get("minimap2_unmapped_bam_align", {}).get("time", config["default_resources"]["time"]),
    container:
        config.get("minimap2_unmapped_bam_align", {}).get("container", config.get("minimap2_align", {}).get("container", config["default_container"]))


# One merged BAM per sample/type from the per-unit alignments, whatever route
# each unit took.
use rule minimap2_merge from alignment as alignment_merge_unit_bams with:
    input:
        bams=get_unit_alignment_bams,
    output:
        bam="alignment/merged/{sample}_{type}.bam",
    params:
        extra=config.get("samtools_merge_bam", {}).get("extra", ""),
    log:
        "logs/samtools_merge_bam/{sample}_{type}.log",
    benchmark:
        repeat(
            "benchmarks/samtools_merge_bam/{sample}_{type}.tsv",
            config.get("samtools_merge_bam", {}).get("benchmark_repeats", 1),
        )
    threads: config.get("samtools_merge_bam", {}).get("threads", config["default_resources"]["threads"])
    resources:
        mem_mb=config.get("samtools_merge_bam", {}).get("mem_mb", config["default_resources"]["mem_mb"]),
        mem_per_cpu=config.get("samtools_merge_bam", {}).get("mem_per_cpu", config["default_resources"]["mem_per_cpu"]),
        partition=config.get("samtools_merge_bam", {}).get("partition", config["default_resources"]["partition"]),
        threads=config.get("samtools_merge_bam", {}).get("threads", config["default_resources"]["threads"]),
        time=config.get("samtools_merge_bam", {}).get("time", config["default_resources"]["time"]),
    container:
        config.get("samtools_merge_bam", {}).get("container", config["default_container"])


# Hydra marks the index temp and matches any BAM.  The merged BAM's index is a
# deliverable that every caller reads, and the other BAMs are indexed by the
# rules that write them, so keep the index and match only the merged BAMs.
use rule samtools_index from alignment as alignment_samtools_index_merged with:
    output:
        bai="{file}.bam.bai",
    log:
        "logs/samtools_index/{file}.log",
    benchmark:
        repeat(
            "benchmarks/samtools_index/{file}.tsv",
            config.get("samtools_index", {}).get("benchmark_repeats", 1),
        )
    wildcard_constraints:
        file=r"alignment/merged/[^/]+",


