# The Hydra rule is per chromosome.  We explicitly wire the chromosome list
# so the DAG does not depend on a network lookup or on a module's default
# chromosome discovery convention.
use rule bcftools_concat from snv_indels as snv_indels_mutect2_concat with:
    input:
        calls=expand(
            "snv_indels/gatk_mutect2/{{sample}}_{{type}}_{chr}.unfiltered.vcf.gz",
            chr=reference_chromosomes,
        ),
        index=expand(
            "snv_indels/gatk_mutect2/{{sample}}_{{type}}_{chr}.unfiltered.vcf.gz.tbi",
            chr=reference_chromosomes,
        ),
    output:
        vcf="snv_indels/bcftools_concat/{sample}_{type}.unfiltered.vcf.gz",
    params:
        extra=config.get("bcftools_concat", {}).get("extra", ""),
    log:
        "logs/bcftools_concat/{sample}_{type}.unfiltered.vcf.gz.log",
    benchmark:
        repeat(
            "benchmarks/bcftools_concat/{sample}_{type}.unfiltered.vcf.gz.tsv",
            config.get("bcftools_concat", {}).get("benchmark_repeats", 1),
        )


use rule tabix from snv_indels as snv_indels_mutect2_tabix with:
    input:
        gz="snv_indels/bcftools_concat/{sample}_{type}.unfiltered.vcf.gz",
    output:
        tbi="snv_indels/bcftools_concat/{sample}_{type}.unfiltered.vcf.gz.tbi",
    log:
        "logs/mutect2_tabix/{sample}_{type}.unfiltered.vcf.gz.tbi.log",
    benchmark:
        repeat(
            "benchmarks/mutect2_tabix/{sample}_{type}.unfiltered.vcf.gz.tbi.tsv",
