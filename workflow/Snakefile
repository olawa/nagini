use rule bed_split from snv_indels as snv_indels_bed_split

use rule gatk_mutect2 from snv_indels as snv_indels_gatk_mutect2 with:
    input:
        map="alignment/merged/{sample}_{type}.bam",
        bai="alignment/merged/{sample}_{type}.bam.bai",
        fasta=config["reference"]["fasta"],
        bed="snv_indels/bed_split/design_bedfile_{chr}.bed",


# The Hydra rule is per chromosome.  We explicitly wire the chromosome list
# so the DAG does not depend on a network lookup or on a module's default
# chromosome discovery convention.
use rule bcftools_concat from snv_indels as snv_indels_mutect2_concat with:
    input:
        calls=expand(
            "snv_indels/gatk_mutect2/{{sample}}_{{type}}_{chr}.unfiltered.vcf.gz",
            chr=reference_chromosomes,
        ),
        index=expand(
            "snv_indels/gatk_mutect2/{{sample}}_{{type}}_{chr}.unfiltered.vcf.gz.tbi",
            chr=reference_chromosomes,
        ),
    output:
        vcf="snv_indels/bcftools_concat/{sample}_{type}.unfiltered.vcf.gz",
    params:
        extra=config.get("bcftools_concat", {}).get("extra", ""),
    log:
        "logs/bcftools_concat/{sample}_{type}.unfiltered.vcf.gz.log",
    benchmark:
        repeat(
            "benchmarks/bcftools_concat/{sample}_{type}.unfiltered.vcf.gz.tsv",
            config.get("bcftools_concat", {}).get("benchmark_repeats", 1),
        )


use rule tabix from snv_indels as snv_indels_mutect2_tabix with:
    input:
        gz="snv_indels/bcftools_concat/{sample}_{type}.unfiltered.vcf.gz",
    output:
        tbi="snv_indels/bcftools_concat/{sample}_{type}.unfiltered.vcf.gz.tbi",
    log:
        "logs/mutect2_tabix/{sample}_{type}.unfiltered.vcf.gz.tbi.log",
    benchmark:
        repeat(
            "benchmarks/mutect2_tabix/{sample}_{type}.unfiltered.vcf.gz.tbi.tsv",
            config.get("tabix", {}).get("benchmark_repeats", 1),
        )


# Config, resources and logs keep nagini's own keys (gatk_merge_mutect_stats,
# gatk_filter_mutect_calls, bcftools_norm_<caller>), so the per-site
# resources_<site>.yaml tuning still applies to the Hydra rules.
use rule gatk_mutect2_merge_stats from snv_indels as snv_indels_gatk_mutect2_merge_stats with:
    input:
        stats=expand(
            "snv_indels/gatk_mutect2/{{sample}}_{{type}}_{chr}.unfiltered.vcf.gz.stats",
            chr=reference_chromosomes,
        ),
    output:
        stats=temp("snv_indels/mutect2_postprocess/{sample}_{type}.unfiltered.merged.stats"),
    params:
        # The Hydra shell has no extra slot; the trailing options ride on the
        # last -stats argument.
        stats=lambda wildcards, input: " ".join(
            [" -stats ".join(input.stats), config.get("gatk_merge_mutect_stats", {}).get("extra", "")]
        ).strip(),
    log:
        "logs/gatk_merge_mutect_stats/{sample}_{type}.log",
    benchmark:
        repeat(
            "benchmarks/gatk_merge_mutect_stats/{sample}_{type}.tsv",
            config.get("gatk_merge_mutect_stats", {}).get("benchmark_repeats", 1),
        )
    threads: config.get("gatk_merge_mutect_stats", {}).get("threads", 1)
    resources:
        mem_mb=config.get("gatk_merge_mutect_stats", {}).get("mem_mb", config["default_resources"]["mem_mb"]),
        mem_per_cpu=config.get("gatk_merge_mutect_stats", {}).get("mem_per_cpu", config["default_resources"]["mem_per_cpu"]),
        partition=config.get("gatk_merge_mutect_stats", {}).get("partition", config["default_resources"]["partition"]),
        threads=config.get("gatk_merge_mutect_stats", {}).get("threads", 1),
        time=config.get("gatk_merge_mutect_stats", {}).get("time", config["default_resources"]["time"]),
    container:
        config.get("gatk_merge_mutect_stats", {}).get(
            "container", config.get("gatk_mutect2", {}).get("container", config["default_container"])
        )


# FilterMutectCalls would otherwise write <vcf>.filteringStats.tsv and its own
# .tbi; the delivered stats path and the tabix rule below rely on neither.
use rule gatk_mutect2_filter from snv_indels as snv_indels_gatk_mutect2_filter with:
    input:
        vcf="snv_indels/bcftools_concat/{sample}_{type}.unfiltered.vcf.gz",
        tbi="snv_indels/bcftools_concat/{sample}_{type}.unfiltered.vcf.gz.tbi",
        stats="snv_indels/mutect2_postprocess/{sample}_{type}.unfiltered.merged.stats",
        ref=config["reference"]["fasta"],
        fai=config["reference"]["fai"],
        dictionary=config["reference"]["dict"],
    output:
        vcf="snv_indels/mutect2_postprocess/{sample}_{type}.filtered.vcf.gz",
        stats="snv_indels/mutect2_postprocess/{sample}_{type}.filteringStats.tsv",
    params:
        extra=lambda wildcards, input, output: (
            f"--stats {input.stats} --filtering-stats {output.stats} "
            f"--create-output-variant-index false {config.get('gatk_filter_mutect_calls', {}).get('extra', '')}"
        ).strip(),
    log:
        "logs/gatk_filter_mutect_calls/{sample}_{type}.log",
    benchmark:
        repeat(
            "benchmarks/gatk_filter_mutect_calls/{sample}_{type}.tsv",
            config.get("gatk_filter_mutect_calls", {}).get("benchmark_repeats", 1),
        )
    threads: config.get("gatk_filter_mutect_calls", {}).get("threads", 1)
    resources:
        mem_mb=config.get("gatk_filter_mutect_calls", {}).get("mem_mb", config["default_resources"]["mem_mb"]),
        mem_per_cpu=config.get("gatk_filter_mutect_calls", {}).get("mem_per_cpu", config["default_resources"]["mem_per_cpu"]),
        partition=config.get("gatk_filter_mutect_calls", {}).get("partition", config["default_resources"]["partition"]),
        threads=config.get("gatk_filter_mutect_calls", {}).get("threads", 1),
        time=config.get("gatk_filter_mutect_calls", {}).get("time", config["default_resources"]["time"]),
    container:
        config.get("gatk_filter_mutect_calls", {}).get(
            "container", config.get("gatk_mutect2", {}).get("container", config["default_container"])
        )


