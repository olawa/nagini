use rule clairs_to_call from snv_indels as snv_indels_clairs_to_call with:
    input:
        bam="alignment/merged/{sample}_{type}.bam",
        bai="alignment/merged/{sample}_{type}.bam.bai",
        ref=config["reference"]["fasta"],
        bed=get_clairs_to_bed,
    output:
        snv=temp("snv_indels/clairs_to/{sample}_{type}_snv.vcf.gz"),
        indel=temp("snv_indels/clairs_to/{sample}_{type}_indel.vcf.gz"),
        snv_tbi=temp("snv_indels/clairs_to/{sample}_{type}_snv.vcf.gz.tbi"),
        indel_tbi=temp("snv_indels/clairs_to/{sample}_{type}_indel.vcf.gz.tbi"),
    params:
        extra=lambda wildcards: (
            f"--remove_intermediate_dir {config.get('clairs_to_call', {}).get('extra', '')}".strip()
        ),
        # The error model follows the sample's basecalling model, and the
        # allele-fraction floors follow its assay: a 20 000x amplicon and a 30x
        # genome cannot share them.
        platform=lambda wildcards: get_clairs_to_platform(wildcards),
        snv_min_af=lambda wildcards: get_clairs_to_snv_min_af(wildcards),
        indel_min_af=lambda wildcards: get_clairs_to_indel_min_af(wildcards),
        outdir=lambda w, output: os.path.dirname(output[0]),
    log:
        "logs/clairs_to_call/{sample}_{type}.log",
    benchmark:
        repeat(
            "benchmarks/clairs_to_call/{sample}_{type}.tsv",
            config.get("clairs_to_call", {}).get("benchmark_repeats", 1),
        )


