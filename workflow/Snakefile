# HYDRA-GENETICS MODULE: snv_indels / DeepVariant (Germline WGS)
# ===========================================================================

# The Hydra rule hands DeepVariant the bare chromosome as --regions, so a
# target-restricted sample was called genome-wide while ClairS-TO ran only
# inside the design.  Pass the design slice instead, and shard only over the
# chromosomes the design covers.
use rule deepvariant from snv_indels as snv_indels_deepvariant with:
    input:
        bam="alignment/merged/{sample}_{type}.bam",
        bai="alignment/merged/{sample}_{type}.bam.bai",
        ref=config["reference"]["fasta"],
        bed=get_deepvariant_regions_bed,
    output:
        vcf=temp("snv_indels/deepvariant/{sample}_{type}_{chr}.vcf.gz"),
        tbi=temp("snv_indels/deepvariant/{sample}_{type}_{chr}.vcf.gz.tbi"),
        int_res=temp(directory("snv_indels/deepvariant/{sample}_{type}_{chr}")),
    params:
        model_type=config.get("deepvariant", {}).get("model_type", "ONT_R104"),
        output_gvcf="",
        int_res=lambda wildcards: f"snv_indels/deepvariant/{wildcards.sample}_{wildcards.type}_{wildcards.chr}",
        regions=get_deepvariant_regions,
        extra=config.get("deepvariant", {}).get("extra", ""),
    log:
        "logs/deepvariant/{sample}_{type}_{chr}.log",
    benchmark:
        repeat(
            "benchmarks/deepvariant/{sample}_{type}_{chr}.tsv",
            config.get("deepvariant", {}).get("benchmark_repeats", 1),
        )


use rule bcftools_concat from snv_indels as snv_indels_deepvariant_concat with:
    input:
        calls=lambda wildcards: get_deepvariant_shards(
            wildcards, "snv_indels/deepvariant/{sample}_{type}_{chr}.vcf.gz"
        ),
        index=lambda wildcards: get_deepvariant_shards(
            wildcards, "snv_indels/deepvariant/{sample}_{type}_{chr}.vcf.gz.tbi"
        ),
        int_res=lambda wildcards: get_deepvariant_shards(
            wildcards, "snv_indels/deepvariant/{sample}_{type}_{chr}"
        ),
    output:
        vcf="snv_indels/deepvariant/{sample}_{type}.vcf.gz",
    params:
        extra=config.get("bcftools_concat", {}).get("extra", ""),
    log:
        "logs/deepvariant_concat/{sample}_{type}.vcf.gz.log",
    benchmark:
        repeat(
            "benchmarks/deepvariant_concat/{sample}_{type}.vcf.gz.tsv",
            config.get("bcftools_concat", {}).get("benchmark_repeats", 1),
        )


use rule tabix from snv_indels as snv_indels_deepvariant_tabix with:
    input:
        gz="snv_indels/deepvariant/{sample}_{type}.vcf.gz",
    output:
        tbi="snv_indels/deepvariant/{sample}_{type}.vcf.gz.tbi",
