use rule cramino from qc as qc_cramino with:
    input:
        bam="alignment/merged/{sample}_{type}.bam",
    output:
        txt="qc/cramino/{sample}_{type}.txt",
        arrow="qc/cramino/{sample}_{type}.arrow",


# Read statistics over the whole BAM are dominated by the reads adaptive
# sampling rejected: a few hundred bases each, at a lower identity than a read
# the pore sequenced to the end. The same statistics over the target BAM
# describe the reads the assay actually calls from.
use rule cramino from qc as qc_cramino_target with:
    input:
        bam="alignment/target/{sample}_{type}.target.bam",
    output:
        txt="qc/cramino_target/{sample}_{type}.txt",
        arrow="qc/cramino_target/{sample}_{type}.arrow",
    log:
        "qc/cramino_target/{sample}_{type}.output.log",
    benchmark:
        repeat(
            "qc/cramino_target/{sample}_{type}.output.benchmark.tsv",
            config.get("cramino", {}).get("benchmark_repeats", 1),
        )


def get_multiqc_input_files(wildcards):
    report_name = getattr(wildcards, "report", "nanopore")
    report_cfg = config.get("multiqc", {}).get("reports", {}).get(report_name, {})
    template_files = report_cfg.get("qc_files", [])
    included_types = set(report_cfg.get("included_unit_types", ["N", "T", "R"]))
    resolved = []
    # Run-level QC belongs to the flowcell, not to a sample, so it is listed
    # separately and only when the run actually produced it.
    for run_file in report_cfg.get("run_files", []):
        if "dorado_demux" in run_file and not dorado_barcodes:
            continue
        resolved.append(run_file)
    for _, row in units.iterrows():
        sample = str(row.get("sample", "")).strip()
        unit_type = str(row.get("type", "")).strip()
        pu = str(row.get("processing_unit", "")).strip()
        barcode = str(row.get("barcode", "")).strip()
        if unit_type in included_types:
            for tf in template_files:
                if "mosdepth_bed" in tf and not sample_has_target_metrics(sample):
                    continue
                if "sv_summary" in tf and not sample_needs_sv_calling(sample):
                    continue
                resolved.append(
                    tf.format(
                        sample=sample,
                        type=unit_type,
                        processing_unit=pu,
                        barcode=barcode,
                    )
                )
    return sorted(set(resolved))


# Hydra's qc module still supplies cramino and MultiQC. The two mosdepth
# rules are local because qc v0.8.0 declares output names that do not match
# the pinned Snakemake wrapper; the local rules below use that same wrapper
# with its supported output names.
use rule multiqc_longread from qc as qc_multiqc_longread with:
    input:
        files=get_multiqc_input_files,


