# 'All' must be defined before module rules are made visible.
rule all:
    input:
        compile_output_file_list,


# ===========================================================================
# HYDRA-GENETICS MODULE: alignment
# ===========================================================================

module alignment:
    snakefile:
        get_module_snakefile(
            config,
            "hydra-genetics/alignment",
            path="workflow/Snakefile",
            tag=config["modules"]["alignment"],
        )
    config:
        config


# Reuse Hydra's minimap2 index rule.  The actual per-unit alignments are
# local rules because the current Hydra minimap2 rule expects a FASTQ-like
# query in the units.tsv bam column and cannot branch on aligned/unmapped BAM.
use rule minimap2_index from alignment as alignment_minimap2_index with:
    input:
        target=config["reference"]["fasta"],
    output:
        mmi=get_reference_index(),


# ===========================================================================
# HYDRA-GENETICS MODULE: cnv_sv
# ===========================================================================

module cnv_sv:
    snakefile:
        get_module_snakefile(
            config,
            "hydra-genetics/cnv_sv",
            path="workflow/Snakefile",
            tag=config["modules"]["cnv_sv"],
        )
    config:
        config


use rule sniffles2_call from cnv_sv as cnv_sv_sniffles2_call with:
    input:
        bam="alignment/quicken_bam/{sample}_{type}.bam",
        bai="alignment/quicken_bam/{sample}_{type}.bam.bai",
        ref=config["reference"]["fasta"],
    output:
        vcf="cnv_sv/sniffles2_call/{sample}_{type}.vcf",
        snf="cnv_sv/sniffles2_call/{sample}_{type}.snf",


use rule bgzip from cnv_sv as cnv_sv_sniffles2_bgzip with:
    input:
        vcf="cnv_sv/sniffles2_call/{sample}_{type}.vcf",
    output:
        gz="cnv_sv/sniffles2_call/{sample}_{type}.vcf.gz",
    log:
        "logs/sniffles2_bgzip/{sample}_{type}.vcf.gz.log",
    benchmark:
        repeat(
            "benchmarks/sniffles2_bgzip/{sample}_{type}.vcf.gz.tsv",
            config.get("bgzip", {}).get("benchmark_repeats", 1),
        )


use rule tabix from cnv_sv as cnv_sv_sniffles2_tabix with:
    input:
        gz="cnv_sv/sniffles2_call/{sample}_{type}.vcf.gz",
    output:
        tbi="cnv_sv/sniffles2_call/{sample}_{type}.vcf.gz.tbi",
    log:
        "logs/sniffles2_tabix/{sample}_{type}.vcf.gz.tbi.log",
    benchmark:
        repeat(
            "benchmarks/sniffles2_tabix/{sample}_{type}.vcf.gz.tbi.tsv",
            config.get("tabix", {}).get("benchmark_repeats", 1),
        )


# ===========================================================================
# HYDRA-GENETICS MODULE: snv_indels / Mutect2
# ===========================================================================

module snv_indels:
    snakefile:
        get_module_snakefile(
            config,
            "hydra-genetics/snv_indels",
            path="workflow/Snakefile",
            tag=config["modules"]["snv_indels"],
        )
    config:
        config


use rule bed_split from snv_indels as snv_indels_bed_split

use rule gatk_mutect2 from snv_indels as snv_indels_gatk_mutect2 with:
    input:
        map="alignment/quicken_bam/{sample}_{type}.bam",
        bai="alignment/quicken_bam/{sample}_{type}.bam.bai",
        fasta=config["reference"]["fasta"],
        bed="snv_indels/bed_split/design_bedfile_{chr}.bed",


# The Hydra rule is per chromosome.  We explicitly wire the chromosome list
# so the DAG does not depend on a network lookup or on a module's default
# chromosome discovery convention.
use rule bcftools_concat from snv_indels as snv_indels_mutect2_concat with:
    input:
        calls=expand(
            "snv_indels/gatk_mutect2/{{sample}}_{{type}}_{chr}.unfiltered.vcf.gz",
            chr=reference_chromosomes,
        ),
        index=expand(
            "snv_indels/gatk_mutect2/{{sample}}_{{type}}_{chr}.unfiltered.vcf.gz.tbi",
            chr=reference_chromosomes,
        ),
    output:
        vcf="snv_indels/bcftools_concat/{sample}_{type}.unfiltered.vcf.gz",
    params:
        extra=config.get("bcftools_concat", {}).get("extra", ""),
    log:
        "logs/bcftools_concat/{sample}_{type}.unfiltered.vcf.gz.log",
    benchmark:
        repeat(
            "benchmarks/bcftools_concat/{sample}_{type}.unfiltered.vcf.gz.tsv",
            config.get("bcftools_concat", {}).get("benchmark_repeats", 1),
        )


use rule tabix from snv_indels as snv_indels_mutect2_tabix with:
    input:
        gz="snv_indels/bcftools_concat/{sample}_{type}.unfiltered.vcf.gz",
    output:
        tbi="snv_indels/bcftools_concat/{sample}_{type}.unfiltered.vcf.gz.tbi",
    log:
        "logs/mutect2_tabix/{sample}_{type}.unfiltered.vcf.gz.tbi.log",
    benchmark:
        repeat(
            "benchmarks/mutect2_tabix/{sample}_{type}.unfiltered.vcf.gz.tbi.tsv",
            config.get("tabix", {}).get("benchmark_repeats", 1),
        )


use rule tabix from snv_indels as snv_indels_filtered_mutect2_tabix with:
    input:
        gz="snv_indels/mutect2_postprocess/{sample}_{type}.filtered.vcf.gz",
    output:
        tbi="snv_indels/mutect2_postprocess/{sample}_{type}.filtered.vcf.gz.tbi",
    log:
        "logs/filtered_mutect2_tabix/{sample}_{type}.log",
    benchmark:
        repeat(
            "benchmarks/filtered_mutect2_tabix/{sample}_{type}.tsv",
            config.get("tabix", {}).get("benchmark_repeats", 1),
        )


use rule bgzip from snv_indels as snv_indels_vep_bgzip with:
    input:
        vcf="snv_indels/mutect2_postprocess/{sample}_{type}.filtered.norm.vep.vcf",
    output:
        gz="snv_indels/mutect2_postprocess/{sample}_{type}.filtered.norm.vep.vcf.gz",
    log:
        "logs/vep_bgzip/{sample}_{type}.log",
    benchmark:
        repeat(
            "benchmarks/vep_bgzip/{sample}_{type}.tsv",
            config.get("bgzip", {}).get("benchmark_repeats", 1),
        )


use rule tabix from snv_indels as snv_indels_vep_tabix with:
    input:
        gz="snv_indels/mutect2_postprocess/{sample}_{type}.filtered.norm.vep.vcf.gz",
    output:
        tbi="snv_indels/mutect2_postprocess/{sample}_{type}.filtered.norm.vep.vcf.gz.tbi",
    log:
        "logs/vep_tabix/{sample}_{type}.log",
    benchmark:
        repeat(
            "benchmarks/vep_tabix/{sample}_{type}.tsv",
            config.get("tabix", {}).get("benchmark_repeats", 1),
        )


# ===========================================================================
# HYDRA-GENETICS MODULE: qc
# ===========================================================================

module qc:
    snakefile:
        get_module_snakefile(
            config,
            "hydra-genetics/qc",
            path="workflow/Snakefile",
            tag=config["modules"]["qc"],
        )
    config:
        config


use rule cramino from qc as qc_cramino with:
    input:
        bam="alignment/quicken_bam/{sample}_{type}.bam",
    output:
        txt="qc/cramino/{sample}_{type}.txt",
        arrow="qc/cramino/{sample}_{type}.arrow",


# Hydra's qc module still supplies cramino and MultiQC.  The two mosdepth
# rules are local because qc v0.8.0 declares output names that do not match
# the pinned Snakemake wrapper; the local rules below use that same wrapper
# with its supported output names.
use rule multiqc_longread from qc as qc_multiqc_longread


# ===========================================================================
# HYDRA-GENETICS MODULE: annotation
# ===========================================================================

module annotation:
    snakefile:
        get_module_snakefile(
            config,
            "hydra-genetics/annotation",
            path="workflow/Snakefile",
            tag=config["modules"]["annotation"],
        )
    config:
        config


# SnpEff is optional because its offline database is reference-specific.  It
# becomes part of rule all when annotate_small_variants/annotate_svs is true.
use rule snpeff from annotation as annotation_snpeff_mutect2 with:
    input:
        vcf="snv_indels/mutect2_postprocess/{sample}_{type}.filtered.norm.vcf.gz",
        tabix="snv_indels/mutect2_postprocess/{sample}_{type}.filtered.norm.vcf.gz.tbi",
        db=config.get("snpeff", {}).get("db", ""),
    output:
        calls="snv_indels/mutect2_postprocess/{sample}_{type}.filtered.norm.snpeff_annotated.vcf.gz",
        csvstats="snv_indels/mutect2_postprocess/{sample}_{type}.filtered.norm.snpeff.csv",
        genes="snv_indels/mutect2_postprocess/{sample}_{type}.filtered.norm.snpeff.genes.txt",
    log:
        "logs/snpeff_mutect2/{sample}_{type}.log",
    benchmark:
        repeat(
            "benchmarks/snpeff_mutect2/{sample}_{type}.tsv",
            config.get("snpeff", {}).get("benchmark_repeats", 1),
        )


use rule snpeff from annotation as annotation_snpeff_sniffles2 with:
    input:
        vcf="cnv_sv/sniffles2_call/{sample}_{type}.vcf.gz",
        tabix="cnv_sv/sniffles2_call/{sample}_{type}.vcf.gz.tbi",
        db=config.get("snpeff", {}).get("db", ""),
    output:
        calls="cnv_sv/sniffles2_call/{sample}_{type}.snpeff_annotated.vcf.gz",
        csvstats="cnv_sv/sniffles2_call/{sample}_{type}.snpeff.csv",
        genes="cnv_sv/sniffles2_call/{sample}_{type}.snpeff.genes.txt",
    log:
        "logs/snpeff_sniffles2/{sample}_{type}.log",
    benchmark:
        repeat(
            "benchmarks/snpeff_sniffles2/{sample}_{type}.tsv",
            config.get("snpeff", {}).get("benchmark_repeats", 1),
        )


use rule simple_sv_annotation from annotation as annotation_simple_sv with:
    input:
        fusion_pairs=config.get("simple_sv_annotation", {}).get("fusion_pairs", ""),
        panel=config.get("simple_sv_annotation", {}).get("panel", ""),
        vcf="cnv_sv/sniffles2_call/{sample}_{type}.snpeff_annotated.vcf.gz",
    output:
        vcf="cnv_sv/sniffles2_call/{sample}_{type}.snpeff_annotated.ss_annotated.vcf",
    log:
        "logs/simple_sv_annotation/{sample}_{type}.log",
    benchmark:
        repeat(
            "benchmarks/simple_sv_annotation/{sample}_{type}.tsv",
            config.get("simple_sv_annotation", {}).get("benchmark_repeats", 1),
        )
