        coverage_csi=temp("qc/mosdepth_bed/{sample}_{type}.per-base.bed.gz.csi"),
        glob="qc/mosdepth_bed/{sample}_{type}.mosdepth.global.dist.txt",
        region="qc/mosdepth_bed/{sample}_{type}.mosdepth.region.dist.txt",
        summary="qc/mosdepth_bed/{sample}_{type}.mosdepth.summary.txt",
    params:
        extra=config.get("mosdepth_bed", {}).get("extra", ""),
