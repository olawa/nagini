# VEP: Hydra's `vep` rule.  It runs with --no_stats, so the *.vep.summary.html
# statistics report is no longer produced or delivered (D16, option 3).
use rule vep from annotation as annotation_vep_mutect2 with:
    input:
        cache=config.get("vep", {}).get("vep_cache", ""),
        fasta=config["reference"]["fasta"],
        tabix="snv_indels/mutect2_postprocess/{sample}_{type}.filtered.norm.vcf.gz.tbi",
        vcf="snv_indels/mutect2_postprocess/{sample}_{type}.filtered.norm.vcf.gz",
    output:
        vcf=temp("snv_indels/mutect2_postprocess/{sample}_{type}.filtered.norm.vep.vcf"),
    params:
        # Hydra's shell has no slot for custom annotations, so ClinVar rides in
        # extra.  Hydra also leaves out --force_overwrite and --no_progress,
        # which do not change the annotation.
        extra=lambda wildcards: " ".join(
            part
            for part in (
                get_vep_custom_annotations(wildcards),
                config.get("vep", {}).get("extra", "--assembly GRCh38 --check_existing --pick --symbol --hgvs"),
            )
            if part
        ),
        mode=config.get("vep", {}).get("mode", "--offline --cache"),
    log:
        "logs/vep_annotate_mutect2/{sample}_{type}.log",
    benchmark:
        repeat(
            "benchmarks/vep_annotate_mutect2/{sample}_{type}.tsv",
            config.get("vep", {}).get("benchmark_repeats", 1),
        )


