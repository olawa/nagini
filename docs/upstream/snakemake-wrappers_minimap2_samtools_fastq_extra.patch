         "master/bio/minimap2/aligner"
 
 
+rule minimap2_ubam_sam_tags:
+    input:
+        target="target/{input1}.mmi",  # can be either genome index or genome fasta
+        query="query/reads.bam",
+    output:
+        "aligned/{input1}_aln.ubam.tags.sam",
